# Copie para .env.local e preencha com os dados do projeto Supabase
# (Project Settings -> API no painel do Supabase).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Número de WhatsApp da CMG3D, com DDI+DDD, só dígitos (sem +, espaço ou
# traço). Sem essa variável o botão "Perguntar no WhatsApp" some sozinho.
NEXT_PUBLIC_WHATSAPP_NUMBER=
